# Configuracion del servicio Chatbot.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
# APP_ENV cumple el papel de NODE_ENV en los servicios NestJS.
APP_ENV=development
SERVICE_NAME=nexus-battle-chatbot
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3011
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI en /api/docs. Deshabilitada en produccion
# por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory:   sin base, para desarrollo y pruebas. PROHIBIDO en produccion.
# postgres: PostgreSQL real; exige DATABASE_URL (postgresql://usuario:clave@host:5432/chatbot).
PERSISTENCE_DRIVER=memory
DATABASE_URL=

# Clave Fernet del historial. Obligatoria en produccion con PostgreSQL:
# sin ella el servicio no arranca, porque el historial tiene que poder
# leerse despues de reiniciar. Se genera con `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
CONVERSATION_CIPHER_KEY=

# --- Autenticacion --------------------------------------------------------
# disabled: se atribuye la identidad `anonymous`. Con APP_ENV=production el
#           servicio NO ARRANCA en este modo (ADR-004).
# jwt:      se exige un testimonio de acceso firmado por el user pool.
AUTH_MODE=disabled

# No son secretos: el identificador del cliente publico viaja en la URL de
# inicio de sesion. Son los valores reales del pool aprovisionado.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# --- Contrato interno entre servicios -------------------------------------
# Secreto HMAC compartido para `/api/internal/v1/...`. Sin el, las rutas
# internas responden 503. Consumidores autorizados (ADR-022): ninguno.
INTERNAL_SERVICE_AUTH_SECRET=
